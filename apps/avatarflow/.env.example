# =============================================================================
# AvatarFlow environment variables
# Copy to .env.local for local development. Never commit .env.local.
# =============================================================================

# Public base URL (used for QR codes, uploaded asset URLs and SEO canonical/sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical public origin for SEO only. Set this in production to the real
# domain (no trailing slash, no path). Falls back to NEXT_PUBLIC_APP_URL.
# Example: NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# --- Admin auth (required) ---------------------------------------------------
# SHA-256 hash of the admin password. Generate:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=
# Long random secret for signing the session cookie. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=admin@avatarflow.local

# --- Database: Supabase ------------------------------------------------------
# Leave the three keys empty to use the local JSON-file backend (.data/db.json).
# Fill all three to switch to Supabase PostgreSQL (apply supabase/migrations/0001_init.sql first).
# New projects: NEXT_PUBLIC_SUPABASE_ANON_KEY = publishable key (sb_publishable_...),
#               SUPABASE_SERVICE_ROLE_KEY    = secret key (sb_secret_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL — used only by migration scripts, never by application code.
DATABASE_URL=
SUPABASE_PROJECT_REF=

# --- Storage: Cloudflare R2 --------------------------------------------------
# Leave empty to store uploaded logos under public/uploads (local dev).
# Fill all four to switch to R2 (S3-compatible endpoint).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=avatarflow
R2_PUBLIC_URL=

# --- Limits (optional) -------------------------------------------------------
LOGO_MAX_BYTES=2097152
GENERATE_RATE_LIMIT=30
TRACK_RATE_LIMIT=60
